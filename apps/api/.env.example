# Database (matches docker/docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=frclone
DB_PASSWORD=frclone123
DB_DATABASE=frclone

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m

# Stream token — separate secret from JWT so a leaked stream URL isn't a full
# API credential. If unset, it derives from JWT_SECRET (weaker than intended).
STREAM_TOKEN_SECRET=your-separate-stream-token-secret-change-in-production
STREAM_TOKEN_EXPIRES_IN=2h

# Redis — backs the durable BullMQ transcode queue (REQUIRED at runtime; a
# missing/unreachable Redis lets the app boot but transcoding fails silently).
REDIS_URL=redis://localhost:6379
# Parallel transcode jobs per API instance.
TRANSCODE_CONCURRENCY=2

# Server
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (SMTP) — leave SMTP_HOST unset in dev; invite/reset-password emails
# are logged to the console instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@rframe.local

# Google OAuth — leave unset to disable "Sign in with Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=32212254720
UPLOAD_CHUNK_SIZE=5242880

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# h264_nvenc when the process has an NVIDIA GPU; libx264 otherwise (auto-fallback).
# TRANSCODE_VIDEO_ENCODER=h264_nvenc

# Puppeteer (PDF export) — point at a system Chromium when the bundled one is
# skipped at install time (as the Docker image does).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
