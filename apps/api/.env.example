# Database (matches docker/docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=frclone
DB_PASSWORD=frclone123
DB_DATABASE=frclone

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m

# Server
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (SMTP) — leave SMTP_HOST unset in dev; invite/reset-password emails
# are logged to the console instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@frameclone.local

# Google OAuth — leave unset to disable "Sign in with Google".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5368709120
UPLOAD_CHUNK_SIZE=5242880

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
