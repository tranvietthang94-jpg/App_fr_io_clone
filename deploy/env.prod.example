# Copy to the repo root as `.env` on the mini PC (next to docker-compose.prod.yml).
# docker compose reads it automatically. NEVER commit the filled-in version.

# Public URL — the single origin for web + api. Must match the Caddy site and
# the DNS A record. Used as CORS origin (api) AND baked into the web build.
PUBLIC_URL=https://app.tenmien.com

# Where video files live on the mini PC's big disk (bind-mounted into the api).
UPLOADS_HOST_DIR=/srv/frclone/uploads

# Database
DB_USERNAME=frclone
DB_PASSWORD=change-me-strong-db-password
DB_DATABASE=frclone

# Secrets — generate with:  openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars
STREAM_TOKEN_SECRET=change-me-different-64-hex-chars
JWT_EXPIRES_IN=15m
STREAM_TOKEN_EXPIRES_IN=2h

# Transcode
TRANSCODE_CONCURRENCY=2
MAX_FILE_SIZE=5368709120
UPLOAD_CHUNK_SIZE=5242880

# Email (optional — unset SMTP_HOST => invite/reset emails just log to console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@frameclone.local

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://app.tenmien.com/api/auth/google/callback
