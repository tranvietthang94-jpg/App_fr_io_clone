# This root file is reference-only: neither `apps/api` nor `apps/web` load a
# root-level .env. Copy the two app-level examples instead:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
#
# The values below just document the default credentials baked into
# docker/docker-compose.yml (postgres/redis/minio).

# Database (postgres container)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=frclone
DB_PASSWORD=frclone123
DB_DATABASE=frclone

# Redis now backs the durable transcode queue (BullMQ). MinIO is still not
# wired in — uploads live on local disk.
REDIS_URL=redis://localhost:6379
# Parallel transcode jobs per API instance (default 2).
TRANSCODE_CONCURRENCY=2
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=frclone
MINIO_SECRET_KEY=frclone123
MINIO_BUCKET=frclone-media
MINIO_USE_SSL=false

# JWT (used by apps/api, see apps/api/.env.example)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Separate secret for video-stream URL tokens (must differ from JWT_SECRET so a
# leaked stream URL isn't a full API credential). Falls back to a value derived
# from JWT_SECRET if unset. TTL bounds a viewing session.
STREAM_TOKEN_SECRET=your-separate-stream-token-secret-change-in-production
STREAM_TOKEN_EXPIRES_IN=2h

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# FFmpeg
FFMPEG_PATH=ffmpeg
